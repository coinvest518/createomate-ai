# Creatomate API Configuration
CREATOMATE_API_KEY=your_creatomate_api_key_here
CREATOMATE_BASE_URL=https://api.creatomate.com/v2

# Google Gemini Configuration
GOOGLE_AI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Default Template Configuration
DEFAULT_TEMPLATE_ID=your_template_id_here

# LangSmith Configuration (Optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fdwa-auto-marketing

# Logging Configuration
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Composio Configuration
COMPOSIO_API_KEY=your_composio_api_key_here

# YouTube Connected Account Configuration
YOUTUBE_CONNECTED_ACCOUNT_ID=your_youtube_account_id_here
YOUTUBE_USER_ID=your_youtube_user_id_here

# Facebook Connected Account Configuration
FACEBOOK_CONNECTED_ACCOUNT_ID=your_facebook_account_id_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Gmail Connected Account Configuration
GMAIL_CONNECTED_ACCOUNT_ID=your_gmail_account_id_here
GMAIL_USER_ID=your_gmail_user_id_here

# Blog Agent Configuration
BLOGGER_EMAIL=your_blogger_email@blogger.com
BLOG_AGENT_ENABLED=true

# Tool Versions
YOUTUBE_TOOL_VERSION=20251027_00
FACEBOOK_TOOL_VERSION=20251104_00
GMAIL_TOOL_VERSION=20251111_00